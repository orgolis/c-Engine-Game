#version 450
// Temporal reprojection / accumulation for the cloud raymarch. Reprojects the
// previous resolved frame by view DIRECTION (clouds are distant, so rotation
// dominates and translation is negligible at the reprojection far point),
// clamps it to the current 3x3 neighbourhood (kills ghosting on disocclusion),
// and blends. `blend` = 1.0 makes this a pass-through (temporal OFF).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Params {
    mat4 inv_view_proj;    // current frame
    mat4 prev_view_proj;   // previous frame
    vec4 camera_pos;       // current
    vec4 misc;             // x=w, y=h, z=blend(1=off), w=reproject_far
} ub;

layout(set = 0, binding = 1) uniform sampler2D currentTex;
layout(set = 0, binding = 2) uniform sampler2D historyTex;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D dstResolved;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(int(ub.misc.x), int(ub.misc.y));
    if (px.x >= size.x || px.y >= size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(size);

    vec4 cur = texture(currentTex, uv);
    float blend = ub.misc.z;
    vec4 result = cur;

    if (blend < 0.999) {
        vec2 ndc = uv * 2.0 - 1.0;
        vec4 wN = ub.inv_view_proj * vec4(ndc, 0.0, 1.0);
        vec4 wF = ub.inv_view_proj * vec4(ndc, 1.0, 1.0);
        vec3 rd = normalize(wF.xyz / wF.w - wN.xyz / wN.w);
        vec3 P = ub.camera_pos.xyz + rd * ub.misc.w;
        vec4 pc = ub.prev_view_proj * vec4(P, 1.0);
        if (pc.w > 0.0) {
            vec2 puv = (pc.xy / pc.w) * 0.5 + 0.5;
            if (all(greaterThanEqual(puv, vec2(0.0))) &&
                all(lessThanEqual(puv, vec2(1.0)))) {
                vec4 hist = texture(historyTex, puv);
                vec2 texel = 1.0 / vec2(size);
                vec4 mn = cur, mx = cur;
                for (int y = -1; y <= 1; ++y)
                for (int x = -1; x <= 1; ++x) {
                    vec4 s = texture(currentTex, uv + vec2(float(x), float(y)) * texel);
                    mn = min(mn, s);
                    mx = max(mx, s);
                }
                hist = clamp(hist, mn, mx);
                result = mix(hist, cur, blend);
            }
        }
    }
    imageStore(dstResolved, px, result);
}
