#version 450
// Volumetric cloud raymarch (half-res). Marches the view ray through a
// curved-earth cloud slab, samples density from the precomputed 3D noise
// volumes (shape + detail), light-marches toward the sun for each lit sample
// (Beer-Lambert + powder + Henyey-Greenstein dual-lobe + a multi-scatter
// octave approximation), and accumulates front-to-back. Writes
// (scattering.rgb, transmittance) for the resolve/composite stages.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Params {
    mat4 inv_view_proj;   // inverse(proj*view) — world view-ray reconstruction
    vec4 camera_pos;      // xyz
    vec4 sun_dir;         // xyz = direction light->scene
    vec4 sun_color;       // rgb = colour*intensity
    vec4 ambient;         // rgb = sky ambient for clouds
    vec4 layer;           // x=earth_radius, y=cloud_bottom, z=cloud_top, w=coverage
    vec4 march;           // x=density, y=extinction, z=steps, w=light_steps
    vec4 scales;          // x=shape_scale, y=detail_scale, z=detail_strength, w=powder
    vec4 phase;           // x=hg_forward, y=hg_back, z=ambient_scale, w=max_march
    vec4 wind;            // xyz=wind dir, w=time (seconds)
    vec4 misc;            // x=scatter_w, y=scatter_h, z=frame, w=unused
} ub;

layout(set = 0, binding = 1) uniform sampler3D shapeNoise;
layout(set = 0, binding = 2) uniform sampler3D detailNoise;
layout(set = 0, binding = 3) uniform sampler2D depthTex;     // G-Buffer depth (sky test)
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dstCloud;

const float PI = 3.14159265358979323846;

float remap(float v, float lo, float hi, float nlo, float nhi) {
    return nlo + (v - lo) / max(hi - lo, 1e-4) * (nhi - nlo);
}

float hg(float c, float g) {
    float g2 = g * g;
    return (1.0 - g2) / (4.0 * PI * pow(max(1.0 + g2 - 2.0 * g * c, 1e-4), 1.5));
}

float ign(ivec2 p, int frame) {
    vec3 m = vec3(float(p.x), float(p.y), float(frame));
    return fract(52.9829189 * fract(dot(m, vec3(0.06711056, 0.00583715, 0.00318513))));
}

// Ray vs sphere (centre c, radius r) → (tNear, tFar), or negative on miss.
vec2 ray_sphere(vec3 ro, vec3 rd, vec3 c, float r) {
    vec3 oc = ro - c;
    float b = dot(oc, rd);
    float cc = dot(oc, oc) - r * r;
    float disc = b * b - cc;
    if (disc < 0.0) return vec2(-1.0);
    float s = sqrt(disc);
    return vec2(-b - s, -b + s);
}

// Cumulus-ish vertical density profile: round bottom, fading top.
float height_gradient(float hf) {
    float bottom = clamp(remap(hf, 0.0, 0.10, 0.0, 1.0), 0.0, 1.0);
    float top    = clamp(remap(hf, 0.20, 1.0, 1.0, 0.0), 0.0, 1.0);
    return bottom * top;
}

vec3 g_center; // earth centre, set in main

float sample_density(vec3 p) {
    float radius = length(p - g_center);
    float h = radius - ub.layer.x;
    float hf = (h - ub.layer.y) / max(ub.layer.z - ub.layer.y, 1e-3);
    if (hf < 0.0 || hf > 1.0) return 0.0;

    vec3 wind_off = ub.wind.xyz * ub.wind.w;
    vec3 sp = (p + wind_off) * ub.scales.x;
    vec4 shape = texture(shapeNoise, sp);
    float base = shape.r;
    float fbm = shape.g * 0.625 + shape.b * 0.25 + shape.a * 0.125;
    base = remap(base, fbm - 1.0, 1.0, 0.0, 1.0);

    // Coverage threshold on the RAW shape first (so it controls how much sky
    // has cloud), THEN shape it vertically. Doing the height gradient before
    // the coverage remap shrinks density into the threshold and zeroes most
    // of the volume → the sparse/fragmented look.
    float cov = ub.layer.w;
    base = remap(base, 1.0 - cov, 1.0, 0.0, 1.0);
    if (base <= 0.0) return 0.0;
    base *= height_gradient(hf);

    // Gentle edge erosion only (no extra density loss in the body).
    vec3 dp = (p + wind_off) * ub.scales.y;
    vec3 det = texture(detailNoise, dp).rgb;
    float det_fbm = det.r * 0.625 + det.g * 0.25 + det.b * 0.125;
    float erosion = det_fbm * ub.scales.z;
    base = remap(base, erosion, 1.0, 0.0, 1.0);

    return clamp(base, 0.0, 1.0) * ub.march.x;
}

// Optical depth toward the sun from p (short light-march).
float light_optical_depth(vec3 p) {
    vec3 L = normalize(-ub.sun_dir.xyz);
    int steps = int(ub.march.w);
    // Cone the light march out a bit each step (cheap multi-scatter blur).
    float dist = (ub.layer.z - ub.layer.y) * 0.5;
    float lstep = dist / float(steps);
    float od = 0.0;
    for (int i = 0; i < steps; ++i) {
        vec3 lp = p + L * (float(i) + 0.5) * lstep;
        od += sample_density(lp) * lstep;
    }
    return od;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(int(ub.misc.x), int(ub.misc.y));
    if (px.x >= size.x || px.y >= size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(size);

    // No clouds in front of scene geometry (clouds sit at sky distance).
    float depth = texture(depthTex, uv).r;
    if (depth < 1.0 - 1e-5) { imageStore(dstCloud, px, vec4(0.0, 0.0, 0.0, 1.0)); return; }

    // World view ray.
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 wN = ub.inv_view_proj * vec4(ndc, 0.0, 1.0);
    vec4 wF = ub.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 ro = ub.camera_pos.xyz;
    vec3 rd = normalize(wF.xyz / wF.w - wN.xyz / wN.w);

    g_center = vec3(ro.x, -ub.layer.x + 0.0, ro.z); // earth centre below camera column
    float r_bot = ub.layer.x + ub.layer.y;
    float r_top = ub.layer.x + ub.layer.z;

    vec2 inner = ray_sphere(ro, rd, g_center, r_bot);
    vec2 outer = ray_sphere(ro, rd, g_center, r_top);

    // Camera below the cloud layer (typical): enter at inner.far, exit outer.far.
    float t_start = inner.y;
    float t_end   = outer.y;
    if (t_end <= 0.0 || t_start >= t_end) {
        imageStore(dstCloud, px, vec4(0.0, 0.0, 0.0, 1.0)); return;
    }
    t_start = max(t_start, 0.0);
    t_end   = min(t_end, t_start + ub.phase.w); // clamp march length

    int steps = int(ub.march.z);
    float step_len = (t_end - t_start) / float(steps);
    float jitter = ign(px, int(ub.misc.z));

    float cos_a = dot(rd, normalize(-ub.sun_dir.xyz));
    float ph = mix(hg(cos_a, ub.phase.x), hg(cos_a, ub.phase.y), 0.5);

    vec3 scattering = vec3(0.0);
    float transmittance = 1.0;
    float ext = ub.march.y;

    for (int i = 0; i < steps; ++i) {
        if (transmittance < 0.01) break;
        float t = t_start + (float(i) + jitter) * step_len;
        vec3 p = ro + rd * t;
        float d = sample_density(p);
        // Soft fade toward the max render distance so distant clouds don't
        // hard-cut at the clamp; phase.w = max march distance.
        d *= 1.0 - smoothstep(0.7, 1.0, (t - t_start) / max(ub.phase.w, 1.0));
        if (d > 0.0) {
            float od = light_optical_depth(p);
            // Multi-scatter octave approximation (Wrenninge).
            float energy = 0.0;
            float a = 1.0, b = 1.0;
            for (int o = 0; o < 3; ++o) {
                energy += a * exp(-od * ext * b);
                a *= 0.5; b *= 0.5;
            }
            float powder = 1.0 - exp(-d * 2.0 * ub.scales.w);
            float powder_term = mix(1.0, powder, 0.4);
            // Boosted silver-lining phase + a multi-scatter floor so clouds
            // read bright white away from the sun instead of grey. ambient.w
            // is the overall cloud brightness gain.
            float phase_lit = ph * 2.5 + 0.5;
            vec3 sun_li = ub.sun_color.rgb * energy * phase_lit * powder_term * ub.ambient.w;
            vec3 amb_li = ub.ambient.rgb * ub.phase.z;
            vec3 L = sun_li + amb_li;
            float sample_trans = exp(-d * ext * step_len);
            scattering += transmittance * L * (1.0 - sample_trans);
            transmittance *= sample_trans;
        }
    }

    imageStore(dstCloud, px, vec4(scattering, transmittance));
}
