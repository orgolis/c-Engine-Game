#version 450
// Voxel-cone-traced ambient occlusion. For each pixel, trace several cones
// over the hemisphere through the scene's voxel occupancy grid (built by
// the voxelization pass) and accumulate occupancy front-to-back. Because
// the grid is world-space, this darkens sealed rooms and off-screen
// occlusion like RT AO — but via voxel sampling instead of ray tracing.
// Cone tracing is inherently smooth, so no separate denoise is needed.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D positionTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;
layout(set = 0, binding = 2, r8) uniform writeonly image2D dstOcclusion;
layout(set = 0, binding = 3) uniform sampler3D voxelTex;
layout(set = 0, binding = 4) uniform VolUBO {
    vec4 vol_min;
    vec4 vol_size;
    vec4 grid;      // x = resolution
} vol;

layout(push_constant) uniform PC {
    ivec2 output_size;
    float intensity;
    float _pad;
} pc;

// 6 cone directions in tangent space (z = up), roughly covering the
// hemisphere: one straight up + a ring of five.
const int   NUM_CONES = 6;
const vec3  kCones[6] = vec3[6](
    vec3( 0.0,      0.0,      1.0),
    vec3( 0.0,      0.866,    0.5),
    vec3( 0.823,    0.267,    0.5),
    vec3( 0.509,   -0.700,    0.5),
    vec3(-0.509,   -0.700,    0.5),
    vec3(-0.823,    0.267,    0.5)
);

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.output_size.x || px.y >= pc.output_size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(pc.output_size);

    vec3 N = texture(normalTex, uv).xyz;
    if (dot(N, N) < 0.01) { imageStore(dstOcclusion, px, vec4(1.0)); return; }
    N = normalize(N);
    vec3 P = texture(positionTex, uv).xyz;

    // Tangent basis.
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T  = normalize(cross(up, N));
    vec3 B  = cross(N, T);

    float voxel = vol.vol_size.x / vol.grid.x;    // world size of one voxel
    const int STEPS = 12;

    float occlusion = 0.0;
    for (int c = 0; c < NUM_CONES; ++c) {
        vec3 dir = normalize(kCones[c].x * T + kCones[c].y * B + kCones[c].z * N);
        float occ  = 0.0;
        float dist = voxel * 1.5;                  // start just off the surface
        for (int s = 0; s < STEPS; ++s) {
            vec3 sp  = P + dir * dist;
            vec3 uvw = (sp - vol.vol_min.xyz) / vol.vol_size.xyz;
            if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) break;
            float v = texture(voxelTex, uvw).r;
            // Front-to-back accumulation with distance falloff.
            float w = 1.0 / (1.0 + dist);
            occ += (1.0 - occ) * v * w;
            dist += voxel * 1.4;                    // widen the cone as we go
        }
        occlusion += occ * kCones[c].z;            // cosine weight (z = up component)
    }
    occlusion = (occlusion / float(NUM_CONES)) * pc.intensity * 2.0;
    imageStore(dstOcclusion, px, vec4(1.0 - clamp(occlusion, 0.0, 1.0)));
}
