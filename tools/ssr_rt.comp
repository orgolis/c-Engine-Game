#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
// Ray-traced reflections with full hit RE-SHADING (Phase 5b). Instead of
// borrowing the hit's colour from the screen (which fails for off-screen
// or occluded geometry → wrong colour / sky), this traces the reflection
// ray against the TLAS, looks up the hit triangle's geometry + material
// via buffer-device-address, and recomputes a flat-shaded lit colour
// (albedo × (ambient + sun·N·L × shadow)) at the hit point. The colour is
// therefore correct regardless of what's on screen.
//
// Limitations (intentional for this pass): flat material colour only (no
// albedo textures in reflections), single directional light, no IBL
// specular at the hit. These keep the pass tractable; they can be layered
// in later if needed.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D positionTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;   // xyz = N, w = roughness
layout(set = 0, binding = 2) uniform sampler2D depthTex;
layout(set = 0, binding = 3) uniform sampler2D albedoTex;   // w = metallic
layout(set = 0, binding = 4) uniform sampler2D hdrTex;      // lit HDR (unused now, kept for parity)
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D dstReflection;
layout(set = 0, binding = 6) uniform samplerCube envCubemap;
layout(set = 0, binding = 7) uniform accelerationStructureEXT sceneTlas;

// SceneVertex = position(3) + normal(3) + uv(2) + tangent(4) = 48 bytes.
struct Vertex { vec3 pos; vec3 normal; vec2 uv; vec4 tangent; };
layout(buffer_reference, scalar) readonly buffer VertexBuf { Vertex v[]; };
layout(buffer_reference, scalar) readonly buffer IndexBuf  { uint   i[]; };

struct RtInstanceData {
    uint64_t vbo_addr;
    uint64_t ibo_addr;
    vec4  base_color;
    float metallic;
    float roughness;
    // Element counts of the buffers the two addresses above point at. These
    // occupy what used to be two unused padding floats, so the struct is
    // still 64 bytes and the C++ side's static_assert still holds.
    //
    // They exist because the fetch below is a RAW DEVICE ADDRESS read: it
    // bypasses descriptors, so nothing but these numbers stands between a
    // stale or mismatched index and an out-of-bounds GPU memory access --
    // which is an MMU fault, which hangs the device, which Windows resolves
    // by resetting the driver (TDR) and the user experiences as a
    // multi-second freeze the renderer never recovers from.
    uint  index_count;
    uint  vertex_count;
    vec4  emissive;
};
layout(set = 0, binding = 8, scalar) readonly buffer InstanceBuffer {
    RtInstanceData instances[];
};
// Lat-long cloud map — composited over the sky on a reflection miss so clouds
// appear in reflections. Sampled only when pc.ambient.w > 0.5 (clouds on).
layout(set = 0, binding = 9) uniform sampler2D cloudSky;

layout(push_constant) uniform PC {
    mat4  view_proj;
    vec4  camera_pos;
    ivec2 output_size;
    float max_distance;
    float thickness;
    int   num_steps;
    float fresnel_power;
    // Number of VALID entries in `instances` this frame. The TLAS can outlive
    // the instance buffer's contents (rebuild_tlas returns early on an
    // allocation failure, leaving last frame's instanceCustomIndex values in
    // a structure whose companion SSBO has already been rewritten), so the
    // index arriving from a ray hit is not automatically in range.
    int   instance_count;
    // 1.0 = a metal's reflection is tinted by its OWN base colour (correct PBR:
    // gold reflects gold). 0.0 = the old neutral-white behaviour, kept as a
    // toggle so the difference can be seen side by side.
    float tint_by_albedo;
    vec4  sun_dir;    // xyz = direction (light → scene)
    vec4  sun_color;  // rgb = colour × intensity
    vec4  ambient;    // rgb = colour × intensity
} pc;

const float kBaseReflect  = 0.02;
const float kSkyClampLuma = 2.0;

// Trace a shadow ray from `p` toward the sun; 1 = lit, 0 = shadowed.
float sun_shadow(vec3 p, vec3 n, vec3 L) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, sceneTlas,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        0xFF, p + n * 0.02, 0.001, L, 1000.0);
    while (rayQueryProceedEXT(rq)) {}
    return (rayQueryGetIntersectionTypeEXT(rq, true) ==
            gl_RayQueryCommittedIntersectionNoneEXT) ? 1.0 : 0.0;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.output_size.x || px.y >= pc.output_size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(pc.output_size);

    // Sky pixels (G-buffer depth at the far plane) carry NO geometry. The
    // normal G-buffer clears to (0,0,1) — NOT zero — so the dot(N,N) test
    // below does NOT catch them. Without this depth gate, SSR treats every
    // sky pixel as a mirror (P=(0,0,0), V=normalize(-camera_pos)), traces a
    // bogus reflection, and composites grey over the sky background that
    // drifts with camera position. Use the same sky test as the lighting pass.
    if (texture(depthTex, uv).r >= 1.0 - 1e-5) {
        imageStore(dstReflection, px, vec4(0.0));
        return;
    }

    vec4 normal_sample = texture(normalTex, uv);
    vec3 N = normal_sample.xyz;
    float roughness = normal_sample.w;
    if (dot(N, N) < 0.01) { imageStore(dstReflection, px, vec4(0.0)); return; }
    N = normalize(N);

    float smoothness = 1.0 - roughness;
    if (smoothness < 0.1) { imageStore(dstReflection, px, vec4(0.0)); return; }

    float metallic = texture(albedoTex, uv).a;
    vec3 P = texture(positionTex, uv).xyz;
    vec3 V = normalize(P - pc.camera_pos.xyz);
    vec3 R = reflect(V, N);

    // Trace the reflection ray.
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, sceneTlas, gl_RayFlagsOpaqueEXT, 0xFF,
        P + N * 0.02, 0.01, R, pc.max_distance);
    while (rayQueryProceedEXT(rq)) {}

    vec3 reflection_color;
    if (rayQueryGetIntersectionTypeEXT(rq, true) !=
        gl_RayQueryCommittedIntersectionNoneEXT) {
        // --- Re-shade the hit point ---
        int   inst_idx = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
        int   prim_idx = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
        vec2  bary     = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        float t        = rayQueryGetIntersectionTEXT(rq, true);
        vec3  hit_pos  = P + N * 0.02 + R * t;

        // EVERY index below is bounds-checked before it reaches memory, and
        // that is not defensive style for its own sake: these are raw
        // buffer_reference reads, so an out-of-range index here is not a
        // garbage pixel, it is a GPU MMU fault -> device hang -> Windows TDR
        // -> the multi-second freeze this pass was disabled for twice. A hit
        // that fails any check falls back to the G-buffer normal and the
        // instance's flat base colour, which is a slightly wrong reflection
        // on one pixel -- a trade with no downside against resetting the GPU.
        vec3 albedo   = vec3(0.5);
        vec3 emissive = vec3(0.0);
        vec3 world_n  = N; // fallback

        if (inst_idx >= 0 && inst_idx < pc.instance_count) {
            RtInstanceData inst = instances[inst_idx];
            albedo   = inst.base_color.rgb;
            emissive = inst.emissive.rgb;

            // prim_idx*3+2 must be a real element of the index buffer, and
            // each index it yields must be a real element of the vertex
            // buffer. prim_idx comes from the BLAS, which is built from a
            // possibly-different snapshot of this mesh than the addresses
            // stored beside it -- a mesh rebuilt at a lower LOD, or freed and
            // reallocated, leaves the two disagreeing.
            uint tri_base = uint(prim_idx) * 3u;
            if (prim_idx >= 0 && inst.vbo_addr != 0ul && inst.ibo_addr != 0ul &&
                tri_base + 2u < inst.index_count) {
                IndexBuf  ib = IndexBuf(inst.ibo_addr);
                VertexBuf vb = VertexBuf(inst.vbo_addr);
                uint i0 = ib.i[tri_base + 0u];
                uint i1 = ib.i[tri_base + 1u];
                uint i2 = ib.i[tri_base + 2u];
                if (i0 < inst.vertex_count && i1 < inst.vertex_count &&
                    i2 < inst.vertex_count) {
                    vec3 n0 = vb.v[i0].normal;
                    vec3 n1 = vb.v[i1].normal;
                    vec3 n2 = vb.v[i2].normal;
                    vec3 bc = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);
                    vec3 local_n = normalize(n0 * bc.x + n1 * bc.y + n2 * bc.z);
                    mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
                    world_n = normalize(mat3(o2w) * local_n);
                }
            }
        }

        // Flat-shaded lighting at the hit.
        vec3 L = normalize(-pc.sun_dir.xyz);
        float ndotl = max(dot(world_n, L), 0.0);
        float shadow = (ndotl > 0.0) ? sun_shadow(hit_pos, world_n, L) : 1.0;
        vec3 lit = albedo * pc.ambient.rgb
                 + albedo * pc.sun_color.rgb * ndotl * shadow
                 + emissive;
        reflection_color = lit;
    } else {
        // Genuine miss — sample the sky.
        reflection_color = texture(envCubemap, R).rgb;
        float l = max(max(reflection_color.r, reflection_color.g), reflection_color.b);
        if (l > kSkyClampLuma) reflection_color *= kSkyClampLuma / l;
        // Composite reflected clouds (lat-long) over the sky.
        if (pc.ambient.w > 0.5) {
            const float PI = 3.14159265358979323846;
            float az = atan(R.x, R.z);
            float el = asin(clamp(R.y, -1.0, 1.0));
            vec2 cuv = vec2(az / (2.0 * PI) + 0.5, el / PI + 0.5);
            vec4 cl = texture(cloudSky, cuv);
            reflection_color = reflection_color * cl.a + cl.rgb;
        }
    }

    // Roughness-aware Fresnel weighting (matches ssr.comp / IBL).
    //
    // F0 for a METAL is its own base colour -- that is what makes gold reflect
    // gold and copper reflect copper. This used to be vec3(1.0), so every metal
    // in the scene reflected neutrally white however it was authored, and the
    // reflecting surface's colour was simply absent from its reflection.
    // Dielectrics keep the ~0.01 grey base, which is physically right: their
    // specular is uncoloured no matter what the diffuse albedo is.
    vec3 surf_albedo = texture(albedoTex, uv).rgb;
    vec3 metal_F0    = mix(vec3(1.0), surf_albedo, pc.tint_by_albedo);
    float NdotV = max(dot(N, -V), 0.0);
    vec3 F0_v = mix(vec3(kBaseReflect), metal_F0, metallic);
    vec3 rough_term = max(vec3(1.0 - roughness), F0_v);
    vec3 F = F0_v + (rough_term - F0_v) *
                    pow(clamp(1.0 - NdotV, 0.0, 1.0), pc.fresnel_power);
    float spec_weight = max(max(F.r, F.g), F.b);
    spec_weight *= mix(smoothness * smoothness, smoothness, metallic);

    // F is a COLOUR and was being collapsed to a scalar here, which threw the
    // hue away even when F0 carried one. The composite blends
    // HDR = rgb*a + HDR*(1-a), so the tint has to ride in rgb: normalise F by
    // its own peak and fold it into the radiance, leaving `a` exactly the
    // strength it always was. Unchanged output for dielectrics and for
    // tint_by_albedo = 0.
    vec3 tint = spec_weight > 1e-5 ? F / max(max(F.r, F.g), F.b) : vec3(1.0);
    imageStore(dstReflection, px, vec4(reflection_color * tint, spec_weight));
}
