#version 450
// Volumetric sun lighting / light shafts (crepuscular rays).
//
// For each (half-res) pixel, reconstructs the world-space view ray and
// ray-marches from the camera to the scene surface (or a max distance for
// sky pixels). At each step it samples the sun's shadow map to decide
// whether that point in the air is lit; lit steps accumulate single-
// scattered in-scattering with Beer-Lambert extinction. A Henyey-Greenstein
// phase function makes shafts brighten when looking toward the sun.
//
// Output is the in-scattered radiance (RGB), later ADDITIVELY composited
// into the HDR target before tone-mapping. Runs at half resolution; the
// composite bilinearly upsamples it.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform Params {
    mat4 inv_view_proj;   // inverse(proj * view) — full, for world-ray reconstruction
    mat4 shadow_matrix;   // sun light view-projection (ortho, ZO depth)
    vec4 camera_pos;      // xyz = world camera position
    vec4 sun_dir;         // xyz = direction (light -> scene), w = density (sigma)
    vec4 sun_color;       // rgb = colour * intensity, w = anisotropy g
    vec4 params;          // x = max_distance, y = intensity, z = num_steps, w = shadow_bias
    vec4 misc;            // x = scatter_width, y = scatter_height, z/w = unused
    vec4 cloud_params;    // x = center.x, y = center.z, z = half_extent, w = enabled
} ub;

layout(set = 0, binding = 1) uniform sampler2D positionTex; // G-Buffer world position
layout(set = 0, binding = 2) uniform sampler2D depthTex;    // G-Buffer depth (sky test)
layout(set = 0, binding = 3) uniform sampler2DArray shadowMap;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dstScatter;
layout(set = 0, binding = 5) uniform sampler2D cloudShadow; // top-down sun transmittance

const float PI = 3.14159265358979323846;

// Henyey-Greenstein phase function. g>0 = forward scattering (bright shafts
// when the view ray points toward the sun).
float henyey_greenstein(float cos_theta, float g) {
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cos_theta;
    return (1.0 - g2) / (4.0 * PI * pow(max(denom, 1e-4), 1.5));
}

// Interleaved gradient noise — cheap per-pixel dither to convert the
// march's banding into high-frequency noise the composite/TAA hides.
float interleaved_gradient_noise(ivec2 p) {
    return fract(52.9829189 * fract(0.06711056 * float(p.x) + 0.00583715 * float(p.y)));
}

// Sun visibility at world point P: 1 = lit, 0 = shadowed. Outside the shadow
// frustum is treated as lit (the camera-anchored ortho box only covers a
// region near the camera; beyond it, no occlusion data → assume lit).
float sun_visibility(vec3 P) {
    vec4 ls = ub.shadow_matrix * vec4(P, 1.0);
    if (ls.w <= 0.0) return 1.0;
    vec3 proj = ls.xyz / ls.w;
    vec2 uv = proj.xy * 0.5 + 0.5;             // ZO ortho: z already in [0,1]
    if (proj.z < 0.0 || proj.z > 1.0 ||
        uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
        return 1.0;
    }
    float bias = ub.params.w;
    float shadow_depth = texture(shadowMap, vec3(uv, 0.0)).r;
    return (proj.z - bias > shadow_depth) ? 0.0 : 1.0;
}

// Cloud transmittance toward the sun at world point P (1 = clear, 0 = under a
// thick cloud). Projects P into the top-down cloud shadow map. Disabled (or
// outside the map) returns 1 so shafts are unaffected.
float cloud_visibility(vec3 P) {
    if (ub.cloud_params.w < 0.5) return 1.0;
    vec2 c = ub.cloud_params.xy;
    float he = ub.cloud_params.z;
    vec2 uv = (P.xz - c) / (2.0 * he) + 0.5;
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return 1.0;
    return clamp(texture(cloudShadow, uv).r, 0.0, 1.0);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(int(ub.misc.x), int(ub.misc.y));
    if (px.x >= size.x || px.y >= size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(size);

    // World-space view ray: unproject two clip-space points along the ray and
    // take their difference (position-independent direction). Matches the
    // lighting pass's reconstruction so it stays correct under this engine's
    // OpenGL [-1,1] depth convention.
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 wN = ub.inv_view_proj * vec4(ndc, 0.0, 1.0);
    vec4 wF = ub.inv_view_proj * vec4(ndc, 1.0, 1.0);
    vec3 p_near = wN.xyz / wN.w;
    vec3 p_far  = wF.xyz / wF.w;
    vec3 dir = normalize(p_far - p_near);
    vec3 origin = ub.camera_pos.xyz;

    // March endpoint: scene surface for geometry, max distance for sky.
    float depth = texture(depthTex, uv).r;
    float max_distance = ub.params.x;
    float end_dist = max_distance;
    if (depth < 1.0 - 1e-5) {
        vec3 world_pos = texture(positionTex, uv).xyz;
        end_dist = min(length(world_pos - origin), max_distance);
    }

    int   num_steps = max(int(ub.params.z), 1);
    float density   = ub.sun_dir.w;
    float g         = ub.sun_color.w;
    float jitter    = interleaved_gradient_noise(px);
    float step_len  = end_dist / float(num_steps);

    float transmittance = 1.0;
    float scatter = 0.0;
    for (int i = 0; i < num_steps; ++i) {
        float t = (float(i) + jitter) * step_len;
        vec3 P = origin + dir * t;
        // Occluded by scene geometry (shadow map) AND by clouds overhead, so
        // shafts brighten in sunlit gaps and darken under clouds (god rays).
        float vis = sun_visibility(P) * cloud_visibility(P);
        // Single-scattering with Beer-Lambert extinction along the ray.
        scatter += vis * density * transmittance * step_len;
        transmittance *= exp(-density * step_len);
    }

    // Phase is constant along a straight ray, so apply once. Scattering angle
    // is between the incident light (sun_dir) and the camera-ward direction.
    float cos_theta = dot(normalize(ub.sun_dir.xyz), -dir);
    float phase = henyey_greenstein(cos_theta, g);

    vec3 in_scatter = scatter * phase * ub.sun_color.rgb * ub.params.y;
    imageStore(dstScatter, px, vec4(max(in_scatter, vec3(0.0)), 1.0));
}
