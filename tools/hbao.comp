#version 450
// Horizon-Based Ambient Occlusion. For each of NUM_DIRECTIONS screen-space
// directions (rotated per-pixel to decorrelate), march outward and track
// the largest "horizon" elevation angle of nearby geometry above the
// surface tangent plane. Occlusion is the averaged horizon sine. More
// physically grounded than plain SSAO → smoother, less haloing.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D positionTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;
layout(set = 0, binding = 2) uniform sampler2D depthTex;
layout(set = 0, binding = 3, r8) uniform writeonly image2D dstOcclusion;

layout(push_constant) uniform PC {
    mat4  view_proj;
    ivec2 output_size;
    float radius;     // world-space falloff
    float bias;       // tangent-angle bias (suppress self-occlusion)
    float intensity;
    float _pad;
} pc;

// F5: positions come from the depth buffer, not a position G-buffer target
// (8 bytes per pixel the G-buffer no longer has to write and every AO
// technique no longer has to read; float32 depth is also more precise than
// the old RGBA16F positions). pc.view_proj is proj * view-ROTATION, so these
// positions are relative to the camera -- AO only ever uses differences
// between them, which are the same as in world space. The convention
// (ndc = uv * 2 - 1, Vulkan depth used as-is) is the lighting pass's, proven by
// tools/gbuffer_reconstruct_check.
mat4 g_inv_vp;
vec3 relPos(vec2 uv) {
    float d = texture(depthTex, uv).r;
    vec4 h = g_inv_vp * vec4(uv * 2.0 - 1.0, d, 1.0);
    return h.xyz / h.w;
}


float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

const float PI = 3.14159265359;

void main() {
    g_inv_vp = inverse(pc.view_proj);
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.output_size.x || px.y >= pc.output_size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(pc.output_size);

    vec3 N = texture(normalTex, uv).xyz;
    if (dot(N, N) < 0.01) { imageStore(dstOcclusion, px, vec4(1.0)); return; }
    N = normalize(N);
    vec3 P = relPos(uv);

    const int NUM_DIRECTIONS = 6;
    const int NUM_STEPS      = 4;
    vec2  texel = 1.0 / vec2(pc.output_size);
    float rnd   = hash(vec2(px));
    // March stride in pixels — scaled a little by inverse depth would be
    // ideal; a fixed stride is fine for a comparison implementation.
    float stride = 8.0;

    float occlusion = 0.0;
    for (int d = 0; d < NUM_DIRECTIONS; ++d) {
        float ang = (float(d) + rnd) / float(NUM_DIRECTIONS) * 2.0 * PI;
        vec2  dir = vec2(cos(ang), sin(ang));
        float maxHorizon = 0.0;             // sine of the highest horizon angle
        for (int s = 1; s <= NUM_STEPS; ++s) {
            vec2 suv = uv + dir * texel * (float(s) * stride);
            if (suv.x < 0.0 || suv.x > 1.0 || suv.y < 0.0 || suv.y > 1.0) break;
            vec3 sp   = relPos(suv);
            vec3 diff = sp - P;
            float dist = length(diff);
            if (dist > 1e-4 && dist < pc.radius) {
                // Elevation above tangent plane, with distance falloff.
                float horizon = dot(diff / dist, N) - pc.bias;
                float falloff = 1.0 - dist / pc.radius;
                maxHorizon = max(maxHorizon, horizon * falloff);
            }
        }
        occlusion += clamp(maxHorizon, 0.0, 1.0);
    }
    occlusion = (occlusion / float(NUM_DIRECTIONS)) * pc.intensity;
    imageStore(dstOcclusion, px, vec4(1.0 - clamp(occlusion, 0.0, 1.0)));
}
