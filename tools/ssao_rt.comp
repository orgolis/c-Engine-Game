#version 460
#extension GL_EXT_ray_query : require
// Ray-traced ambient occlusion written into the SSAO pass's R8 occlusion
// image, so the existing bilateral blur denoises it. Replaces the noisy
// inline AO that used to run in the lighting shader: computing AO here +
// blurring downstream removes the per-pixel grain while keeping the
// long-range "is this point enclosed?" occlusion that darkens sealed rooms.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D positionTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;
layout(set = 0, binding = 2) uniform sampler2D depthTex;     // layout parity (unused)
layout(set = 0, binding = 3, r8) uniform writeonly image2D dstOcclusion;
layout(set = 0, binding = 4) uniform accelerationStructureEXT sceneTlas;

layout(push_constant) uniform PC {
    mat4  view_proj;
    ivec2 output_size;
    float radius;        // RT AO ray length (world units)
    float bias;
    float intensity;
    float _pad;
} pc;

float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.output_size.x || px.y >= pc.output_size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(pc.output_size);

    vec3 N = texture(normalTex, uv).xyz;
    if (dot(N, N) < 0.01) { imageStore(dstOcclusion, px, vec4(1.0)); return; } // sky
    N = normalize(N);
    vec3 P = texture(positionTex, uv).xyz;

    const int   AO_SAMPLES = 12;
    float radius = pc.radius > 0.0 ? pc.radius : 30.0;

    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T  = normalize(cross(up, N));
    vec3 B  = cross(N, T);

    float rnd = hash(vec2(px));
    vec3  origin = P + N * 0.02;
    float occluded = 0.0;
    for (int i = 0; i < AO_SAMPLES; ++i) {
        float u1 = fract(rnd + float(i) * 0.6180339887);
        float u2 = fract(rnd * 1.3247179572 + float(i) * 0.7548776662);
        float r   = sqrt(u1);
        float phi = 6.2831853 * u2;
        vec3 dir_t = vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
        vec3 dir   = normalize(dir_t.x * T + dir_t.y * B + dir_t.z * N);

        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, sceneTlas,
            gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT |
            gl_RayFlagsSkipClosestHitShaderEXT,
            0xFF, origin, 0.01, dir, radius);
        while (rayQueryProceedEXT(rq)) {}
        if (rayQueryGetIntersectionTypeEXT(rq, true) !=
            gl_RayQueryCommittedIntersectionNoneEXT) {
            occluded += 1.0;
        }
    }
    float ao = 1.0 - (occluded / float(AO_SAMPLES));
    imageStore(dstOcclusion, px, vec4(ao));
}
