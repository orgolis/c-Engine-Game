#version 460
#extension GL_EXT_ray_query : require
// Ray-traced ambient occlusion + REPROJECTED temporal accumulation. Each frame
// casts a fresh set of rays (seed rotated by frame), then blends with the
// accumulated history sampled at where this world point was LAST frame — so the
// grain converges to smooth even while the camera moves. The reprojection
// auto-calibrates the projection's axis convention against the known current
// pixel UV, so a Y/X flip cannot break it.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D positionTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;
layout(set = 0, binding = 2) uniform sampler2D depthTex;     // layout parity (unused)
layout(set = 0, binding = 3, r8) uniform writeonly image2D dstOcclusion;
layout(set = 0, binding = 4) uniform accelerationStructureEXT sceneTlas;
layout(set = 0, binding = 5) uniform sampler2D historyTex;   // previous frame's accumulated AO

layout(push_constant) uniform PC {
    mat4  cur_view_proj;   // this frame's view*proj (to self-calibrate the UV convention)
    mat4  prev_view_proj;  // last frame's view*proj (to reproject the history)
    ivec2 output_size;
    float radius;
    float bias;
    float intensity;
    int   frame;
    int   accumulate;
} pc;

float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.output_size.x || px.y >= pc.output_size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(pc.output_size);

    vec3 N = texture(normalTex, uv).xyz;
    if (dot(N, N) < 0.01) { imageStore(dstOcclusion, px, vec4(1.0)); return; } // sky
    N = normalize(N);
    vec3 P = texture(positionTex, uv).xyz;

    const int AO_SAMPLES = 32;
    float radius = pc.radius > 0.0 ? pc.radius : 30.0;

    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T  = normalize(cross(up, N));
    vec3 B  = cross(N, T);

    float rnd = hash(vec2(px) + vec2(float(pc.frame)) * vec2(0.618034, 0.381966));
    vec3  origin = P + N * 0.02;
    float occluded = 0.0;
    for (int i = 0; i < AO_SAMPLES; ++i) {
        float u1 = fract(rnd + float(i) * 0.6180339887);
        float u2 = fract(rnd * 1.3247179572 + float(i) * 0.7548776662);
        float r   = sqrt(u1);
        float phi = 6.2831853 * u2;
        vec3 dir_t = vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
        vec3 dir   = normalize(dir_t.x * T + dir_t.y * B + dir_t.z * N);

        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, sceneTlas,
            gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT |
            gl_RayFlagsSkipClosestHitShaderEXT,
            0xFF, origin, 0.01, dir, radius);
        while (rayQueryProceedEXT(rq)) {}
        if (rayQueryGetIntersectionTypeEXT(rq, true) !=
            gl_RayQueryCommittedIntersectionNoneEXT) {
            occluded += 1.0;
        }
    }
    float ao = 1.0 - (occluded / float(AO_SAMPLES));

    if (pc.accumulate != 0) {
        vec4 cc = pc.cur_view_proj  * vec4(P, 1.0);
        vec4 pp = pc.prev_view_proj * vec4(P, 1.0);
        if (cc.w > 0.0 && pp.w > 0.0) {
            // Project under both matrices (no-flip assumption), then per-axis
            // pick whichever orientation makes THIS frame's projection match the
            // known current UV — and apply the same orientation to the previous
            // frame's projection. This makes the reprojection convention-proof.
            vec2 cur_proj  = (cc.xy / cc.w) * 0.5 + 0.5;
            vec2 prev_proj = (pp.xy / pp.w) * 0.5 + 0.5;
            bvec2 flip = greaterThan(abs(cur_proj - uv), abs((vec2(1.0) - cur_proj) - uv));
            vec2 prev_uv = mix(prev_proj, vec2(1.0) - prev_proj, vec2(flip));
            if (all(greaterThanEqual(prev_uv, vec2(0.0))) &&
                all(lessThanEqual(prev_uv, vec2(1.0)))) {
                float hist = texture(historyTex, prev_uv).r;
                ao = mix(hist, ao, 0.1);
            }
        }
    }
    imageStore(dstOcclusion, px, vec4(ao));
}
