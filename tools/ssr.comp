#version 450
// Screen-space reflections — coarse linear march in world space + binary
// search refinement around the first crossing. Allows dielectric
// reflections weighted by Fresnel + smoothness, so wet floors / glossy
// non-metals also reflect (just more subtly than mirrors).
//
// Per output pixel:
//   1. Read G-Buffer N, P, metallic, roughness.
//   2. Compute reflection direction R = reflect(V, N).
//   3. Coarse march N_STEPS samples along R. At each step project to NDC
//      and compare ray depth to the depth buffer. Track the previous
//      step's ray position so when we detect "ray is now behind", we can
//      binary-search the bracket [prev, current] for the exact crossing.
//   4. After binary refinement, sample the lit HDR at the refined hit UV.
//   5. Weight the output alpha by:
//        edge fade * specular_weight * fresnel
//      where specular_weight = mix(0.02, 1.0, metallic) blends in a small
//      dielectric base reflectance even when metallic is near zero, and
//      multiplied by (1 - roughness) so very rough surfaces fade out.
//   6. Output rgba = (reflection_color, blend_mask).
//
// Per-pixel jitter on the first-step offset breaks up the discrete banding
// from the coarse linear march before refinement kicks in.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D positionTex;
layout(set = 0, binding = 1) uniform sampler2D normalTex;   // xyz = world N, w = roughness
layout(set = 0, binding = 2) uniform sampler2D depthTex;
layout(set = 0, binding = 3) uniform sampler2D albedoTex;   // w = metallic
layout(set = 0, binding = 4) uniform sampler2D hdrTex;      // lit HDR
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D dstReflection;
layout(set = 0, binding = 6) uniform samplerCube envCubemap; // sky on ray miss

layout(push_constant) uniform PC {
    mat4 view_proj;
    vec4 camera_pos;
    ivec2 output_size;
    float max_distance;
    float thickness;       // NDC z tolerance after refinement
    int   num_steps;       // coarse marching steps
    float fresnel_power;
    // Both variants share ONE host-side push struct, so these two must keep the
    // ray-traced shader's offsets: instance_count is meaningless here, and
    // tint_by_albedo means the same thing in both (1.0 = a metal's reflection
    // carries its own base colour).
    int   _unused_instance_count;
    float tint_by_albedo;
} pc;

const int   kRefineSteps = 6;     // binary-search refinement iterations
const float kBaseReflect = 0.01;  // dielectric base reflectance (~F0 for plastic)
const float kSkyClampLuma = 2.0;  // HDR sample luminance clamp (anti-sky-blowout)

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// Project a world-space point into NDC. Returns false if behind near plane.
bool project(vec3 world_pos, out vec3 ndc) {
    vec4 clip = pc.view_proj * vec4(world_pos, 1.0);
    if (clip.w <= 0.0) return false;
    ndc = clip.xyz / clip.w;
    return true;
}

bool in_ndc(vec3 ndc) {
    return all(lessThanEqual(abs(ndc.xy), vec2(1.0))) &&
           ndc.z >= 0.0 && ndc.z <= 1.0;
}

// World-space "behind" test. Projects `world_pos` to screen, reads the
// G-Buffer world position at that pixel, and compares distance-from-camera.
// `delta` is (ray_dist - scene_dist) in WORLD units: > 0 means the ray
// point is behind the scene surface. Using world distance (not raw NDC-z)
// makes the thickness tolerance uniform regardless of how far the
// reflective surface is from the camera — fixing the artifact where only
// objects farther than the camera-to-surface distance got reflected.
//
// `valid` is false when the projected pixel has no geometry (sky / empty
// G-Buffer), so the ray doesn't spuriously "hit" the cleared position 0.
bool point_is_behind(vec3 world_pos, out vec3 ndc, out vec2 uv,
                     out float delta, out bool valid) {
    delta = 0.0; valid = false;
    if (!project(world_pos, ndc)) { uv = vec2(0); return false; }
    if (!in_ndc(ndc))            { uv = vec2(0); return false; }
    uv = ndc.xy * 0.5 + 0.5;

    // Empty-pixel rejection: the normal G-Buffer is cleared to ~0 where no
    // geometry was drawn. Skip those so the ray passes over the sky.
    vec3 scene_n = texture(normalTex, uv).xyz;
    if (dot(scene_n, scene_n) < 0.01) { return false; }

    vec3  scene_pos = texture(positionTex, uv).xyz;
    float ray_dist   = distance(world_pos, pc.camera_pos.xyz);
    float scene_dist = distance(scene_pos, pc.camera_pos.xyz);
    delta = ray_dist - scene_dist;
    valid = true;
    return delta > 0.0;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.output_size.x || px.y >= pc.output_size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(pc.output_size);

    vec4 normal_sample = texture(normalTex, uv);
    vec3 N = normal_sample.xyz;
    float roughness = normal_sample.w;
    if (dot(N, N) < 0.01) {
        imageStore(dstReflection, px, vec4(0.0));
        return;
    }
    N = normalize(N);

    // Smooth-ish surface required for SSR to look plausible. Very rough
    // surfaces fade to zero contribution. SSR at high roughness needs a
    // multi-sample blur which we don't do here.
    float smoothness = 1.0 - roughness;
    if (smoothness < 0.1) {
        imageStore(dstReflection, px, vec4(0.0));
        return;
    }

    float metallic = texture(albedoTex, uv).a;
    vec3 P = texture(positionTex, uv).xyz;
    vec3 V = normalize(P - pc.camera_pos.xyz);
    vec3 R = reflect(V, N);

    // Coarse march. Jitter the first step by [0, 1) of a step length so
    // the discrete steps don't show banding when refinement isn't enough.
    float step_size = pc.max_distance / float(pc.num_steps);
    float jitter = hash12(vec2(px));

    vec3 prev_pos = P;
    bool found = false;
    vec3 hit_ndc; vec2 hit_uv;

    for (int i = 1; i <= pc.num_steps; ++i) {
        vec3 cur_pos = P + R * ((float(i) + jitter) * step_size);
        vec3 ndc; vec2 cuv; float delta; bool valid;
        bool behind = point_is_behind(cur_pos, ndc, cuv, delta, valid);
        // Stop if we left the screen entirely.
        if (!project(cur_pos, ndc) || !in_ndc(ndc)) {
            break;
        }
        // `behind` is only true at valid (geometry) pixels — sky pixels
        // never trigger a hit, the ray just keeps marching.
        if (behind) {
            // Binary-search refine between prev_pos (in front) and
            // cur_pos (behind) for the exact crossing.
            vec3 lo = prev_pos;
            vec3 hi = cur_pos;
            float hi_delta = delta;
            for (int j = 0; j < kRefineSteps; ++j) {
                vec3 mid = (lo + hi) * 0.5;
                vec3 mndc; vec2 muv; float mdelta; bool mvalid;
                if (point_is_behind(mid, mndc, muv, mdelta, mvalid)) {
                    hi = mid; hi_delta = mdelta;
                    hit_ndc = mndc; hit_uv = muv;
                } else {
                    lo = mid;
                }
            }
            // World-space thickness acceptance: reject when the ray has
            // punched far past the surface (e.g. through a thin object out
            // to distant background). `pc.thickness` is now WORLD units.
            if (hi_delta < pc.thickness) {
                found = true;
            }
            break;
        }
        prev_pos = cur_pos;
    }

    // Determine the reflection colour:
    //   - SSR object hit → sample the lit HDR at the hit pixel.
    //   - Miss (ray left screen / reached sky) → sample the env cubemap
    //     in the reflection direction. This makes SSR the single source
    //     of specular reflection (object where on-screen, sky elsewhere),
    //     so the lighting pass can suppress its IBL specular for smooth
    //     surfaces and the two no longer double-count / fight.
    vec3 hit_color;
    float fade;
    if (found) {
        hit_color = texture(hdrTex, hit_uv).rgb;
        vec2 edge = abs(hit_ndc.xy);
        fade = 1.0 - smoothstep(0.6, 1.0, max(edge.x, edge.y));
    } else {
        hit_color = texture(envCubemap, R).rgb;
        fade = 1.0; // sky is omnipresent — no screen-edge fade
    }

    // Soft-clamp so HDR sky pixels (which can be 5-10x brighter than
    // lit-scene pixels) don't blow out the reflection.
    float hit_luma = max(max(hit_color.r, hit_color.g), hit_color.b);
    if (hit_luma > kSkyClampLuma) {
        hit_color *= kSkyClampLuma / hit_luma;
    }

    // Roughness-aware Fresnel — same approximation as IBL. For rough
    // surfaces this caps the grazing-angle boost so non-metals at
    // roughness ~0.7 don't pop to mirror-like reflection at edges.
    //
    // F0 for a METAL is its own base colour — gold reflects gold. This was
    // vec3(1.0), so every metal reflected neutrally white however it was
    // authored. Fixed in BOTH variants together on purpose: if only the
    // ray-traced one carried surface colour, ticking the Ray-traced checkbox
    // would change what metals look like as well as how accurate the
    // reflections are, and that reads as a broken toggle.
    vec3 surf_albedo = texture(albedoTex, uv).rgb;
    vec3 metal_F0    = mix(vec3(1.0), surf_albedo, pc.tint_by_albedo);
    float NdotV = max(dot(N, -V), 0.0);
    vec3 F0_v = mix(vec3(kBaseReflect), metal_F0, metallic);
    vec3 rough_term = max(vec3(1.0 - roughness), F0_v);
    vec3 F = F0_v + (rough_term - F0_v) *
                    pow(clamp(1.0 - NdotV, 0.0, 1.0), pc.fresnel_power);
    float spec_weight = max(max(F.r, F.g), F.b);
    // Smoothness falloff: aggressive (squared) for non-metals so glossy
    // dielectrics don't accumulate too much reflection, but barely-damped
    // (linear) for metals so a shiny metal SSR hit fully overrides the
    // HDR — otherwise the lighting pass's IBL specular term leaves a
    // residual sky tint visible THROUGH the SSR object reflection.
    float smoothness_damp = mix(smoothness * smoothness, smoothness, metallic);
    spec_weight *= smoothness_damp;

    float alpha = fade * spec_weight;
    // Fold the COLOURED Fresnel into the radiance. spec_weight already took F's
    // peak, so normalising by that peak leaves alpha exactly the strength it
    // was and puts the hue where the composite can see it — it blends
    // HDR = rgb*a + HDR*(1-a) and never looks at anything but rgb and a.
    vec3 tint = spec_weight > 1e-5 ? F / max(max(F.r, F.g), F.b) : vec3(1.0);
    imageStore(dstReflection, px, vec4(hit_color * tint, alpha));
}
