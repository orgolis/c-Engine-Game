# Build directories
build/
build-*/
cmake-build-debug/
cmake-build-release/
cmake-build-*/

# IDE files
.vs/
.vscode/
.idea/
*.code-workspace

# Visual Studio
*.vcxproj.user
*.vcxproj.filters
*.sln
*.suo
*.sdf
*.opensdf
*.db

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
CMakeLists.txt.user
cmake_install.cmake
Makefile
# Generated CMake fragments. Build directories are already ignored above, so
# this only catches strays from an in-source configure.
*.cmake
# ...but hand-written CMake modules are SOURCE and must be tracked. Without
# these negations a real module is silently invisible to git — the same class
# of bug that left third_party/ufbx's build glue out of every clone.
!third_party/*.cmake
!cmake/*.cmake

# Build artifacts
bin/
lib/
*.o
*.a
*.so
*.dylib
*.exe
*.dll

# macOS
*.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.swp
*.swo
*~
*.bak

# Build logs
build*.log
build*.txt
*_build.txt
final_build.txt
*.tmp
*.log

# User-specific VS Code settings (but not extensions)
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
