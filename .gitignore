# Build directories
build/
build-*/
cmake-build-debug/
cmake-build-release/
cmake-build-*/

# IDE files
.vs/
.vscode/
.idea/
*.code-workspace

# Visual Studio
*.vcxproj.user
*.vcxproj.filters
*.sln
*.suo
*.sdf
*.opensdf
*.db

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
CMakeLists.txt.user
cmake_install.cmake
Makefile
# Generated CMake fragments. Build directories are already ignored above, so
# this only catches strays from an in-source configure.
*.cmake
# ...but hand-written CMake modules are SOURCE and must be tracked. Without
# these negations a real module is silently invisible to git — the same class
# of bug that left third_party/ufbx's build glue out of every clone.
!third_party/*.cmake
!cmake/*.cmake

# Build artifacts. Anchored to the repo root with a leading slash: an
# unanchored `lib/` also matched third_party/zstd/lib/, which is zstd's SOURCE
# tree, so 103 vendored source files were silently never committed and clean
# clones failed at `add_library(zstd ...)` with "No SOURCES given to target".
/bin/
/lib/
*.o
*.a
*.so
*.dylib
*.exe
*.dll

# macOS
*.DS_Store
.AppleDouble
.LSOverride

# Temporary files
*.swp
*.swo
*~
*.bak

# Build logs
build*.log
build*.txt
*_build.txt
final_build.txt
*.tmp
*.log

# User-specific VS Code settings (but not extensions)
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json

# Editor/runtime artifacts
editor.ini
script_cache/
