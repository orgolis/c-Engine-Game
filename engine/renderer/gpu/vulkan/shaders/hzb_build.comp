#version 450

// Hierarchical Z-Buffer (HZB) Compute Shader
// Builds mipmap chain from input depth texture for occlusion culling
// Each level stores maximum depth to be conservative

layout (local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D input_depth;
layout(set = 0, binding = 1, rgba32f) uniform image2D output_hzb;

layout(push_constant) uniform HZBConstants {
    ivec2 src_size;    // Resolution of source (previous level or initial depth)
    ivec2 dst_size;    // Resolution of destination (current level)
    uint mip_level;    // Current mip level being generated
} pc;

void main() {
    ivec2 dst_coord = ivec2(gl_GlobalInvocationID.xy);
    
    // Out of bounds check
    if (dst_coord.x >= pc.dst_size.x || dst_coord.y >= pc.dst_size.y) {
        return;
    }
    
    // Sample 4 texels from previous level (2x2 neighborhood)
    ivec2 src_coord = dst_coord * 2;
    
    // Sample from texture (converts to normalized coordinates)
    vec2 texel_size = 1.0 / vec2(pc.src_size);
    vec2 uv_base = (vec2(src_coord) + 0.5) * texel_size;
    
    // Sample the 4 corners of 2x2 neighborhood
    float d0 = texture(input_depth, uv_base).r;
    float d1 = texture(input_depth, uv_base + vec2(texel_size.x, 0.0)).r;
    float d2 = texture(input_depth, uv_base + vec2(0.0, texel_size.y)).r;
    float d3 = texture(input_depth, uv_base + texel_size).r;
    
    // Conservative: take maximum depth (farthest = largest Z in [0,1])
    float max_depth = max(max(max(d0, d1), d2), d3);
    
    // Store result in output mip level
    // For HZB, we typically store depth in each channel for multiple uses
    imageStore(output_hzb, dst_coord, vec4(max_depth, max_depth, max_depth, 1.0));
}
